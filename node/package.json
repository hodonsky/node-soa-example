{
  "name"       : "donsky_server",
  "version"    : "1.0.0",
  "description": "Donsky's Server",
  "author"     : "eric.hodonsky@gmail.com",
  "license"    : "MIT",
  "scripts": {
    "test"       : "mocha --exit --require /usr/src/deps/node_modules/babel-core/register",
    "prebuild"   : "npm version patch",
    "build"      : "npx babel --config-file /usr/src/deps/babel.json --out-dir /usr/src/dist --source-maps --copy-files /usr/src/app && cp ./package.json /usr/src/dist",
    "prestart"   : "node /usr/src/deps/node_modules/.bin/pm2 flush",
    "start"      : "node /usr/src/deps/node_modules/.bin/pm2 start --no-daemon ${SOA_PATH} -i 1",
    "restart"    : "npm run build && node /usr/src/deps/node_modules/.bin/pm2 kill && sleep 2 && npm start",
    "poststart"  : "node /usr/src/deps/node_modules/.bin/pm2 logs --format 'all'"
  },
  "engines": {
    "node": ">=22.9.0",
    "npm" : ">=10.8.3"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.637.0",
    "@aws-sdk/lib-dynamodb": "^3.637.0",
    "crypto-js": "4.2.0",
    "@donsky/node-gateway": "./node-gateway",
    "@donsky/node-service": "./node-service",
    "njwt": "2.0.1",
    "pm2": "^5.4.2",
    "sha256": "0.2.0",
    "uuid": "10.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.8",
    "@babel/core": "^7.25.2",
    "@babel/eslint-parser": "^7.25.1",
    "@babel/plugin-proposal-do-expressions": "^7.24.7",
    "@babel/plugin-proposal-export-default-from": "^7.24.7",
    "@babel/plugin-proposal-function-bind": "^7.24.7",
    "@babel/plugin-proposal-partial-application": "^7.24.7",
    "@babel/plugin-proposal-pipeline-operator": "^7.24.7",
    "@babel/plugin-proposal-throw-expressions": "^7.24.7",
    "@babel/plugin-transform-class-properties": "^7.25.4",
    "@babel/plugin-transform-export-namespace-from": "^7.24.7",
    "@babel/plugin-transform-nullish-coalescing-operator": "^7.24.7",
    "@babel/plugin-transform-object-rest-spread": "^7.24.7",
    "@babel/plugin-transform-optional-chaining": "^7.24.8",
    "@babel/plugin-transform-private-methods": "^7.25.4",
    "@babel/plugin-transform-runtime": "^7.25.4",
    "@babel/preset-env": "^7.25.4",
    "@babel/register": "^7.24.6",
    "babel-loader": "^9.1.3",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-minify": "^0.5.2",
    "babel-plugin-tcomb": "^0.4.0",
    "chai": "^5.1.1",
    "chai-as-promised": "^8.0.0",
    "eslint": "^9.9.1",
    "eslint-webpack-plugin": "^4.2.0",
    "exports-loader": "^5.0.0",
    "mocha": "^10.7.3",
    "rimraf": "^6.0.1",
    "sinon": "^18.0.0",
    "terser-webpack-plugin": "^5.3.10",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-node-externals": "^3.0.0",
    "tcomb": "^3.2.29"
  }
}
